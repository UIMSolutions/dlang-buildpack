#!/usr/bin/env bash
set -eo pipefail

BUILD_DIR=$1
CACHE_DIR=$2
BUILDPACK_DIR=$(dirname "$(cd "$(dirname "$0")" && pwd)")

echo "-----> Starte Dlang Buildpack Staging"

# 1. Compiler-Verzeichnis im App-Workspace vorbereiten
mkdir -p "$BUILD_DIR/.dlang"

# 2. Vorkompilierten Compiler entpacken (aus dem Buildpack-Ordner extrahiert)
echo "-----> Installiere DMD Compiler..."
tar -xJf "$BUILDPACK_DIR/resources/dmd.2.112.0.linux.tar.xz" -C "$BUILD_DIR/.dlang" --strip-components=1

# 3. Pfade für die Kompilierung setzen
export PATH="$BUILD_DIR/.dlang/linux/bin64:$PATH"

# 4. Abhängigkeiten via Dub auflösen und App kompilieren
cd "$BUILD_DIR"
echo "-----> Kompiliere Anwendung via Dub..."

# Vorher:
dub build --compiler=dmd --build=release --skip-registry --compiler-flags="-lowmem -vcolumns"

# Nachher (Wechsel auf Debug + maximale Spar-Flags):
# dub build --compiler=dmd --build=debug --skip-registry --compiler-flags="-lowmem -g- -O0"


echo "-----> Kompilierung erfolgreich abgeschlossen."
